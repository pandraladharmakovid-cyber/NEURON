{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parsed CSV table boundary",
  "type": "object",
  "required": [
    "headers",
    "rows"
  ],
  "properties": {
    "headers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25000,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 100,
        "items": {
          "type": "string",
          "maxLength": 4096
        }
      }
    }
  },
  "description": "Runtime additionally checks case-insensitive header uniqueness, trimming, equal row width, UTF-8 file bytes and 500000-cell budget."
}
